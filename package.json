{
  "name": "cerne-fiscal",
  "version": "0.1.0",
  "updated": "2026.07.24.1636",
  "description": "O Cerne Fiscal extrai chaves de acesso de NF-e e NFC-e em arquivos PDF locais ou remotos usando processamento somente por CPU.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "cerne-fiscal": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "nfe",
    "nfce",
    "danfe",
    "pdf",
    "access-key",
    "barcode",
    "ocr",
    "brazil"
  ],
  "author": "devAlphaSystem",
  "license": "MIT",
  "scripts": {
    "build": "tsup ./src/index.ts ./src/cli.ts --no-config --format esm,cjs --dts --sourcemap --clean --no-splitting --platform node --target node20 --out-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=low",
    "check": "tsc --noEmit && eslint . && prettier --check . && npm run build",
    "prepack": "npm run check",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/library": "^0.23.0",
    "pdfjs-dist": "^6.1.200",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "patch-package": "^8.0.1",
    "prettier": "3.9.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
